#: fields.py:299 relations.py:246 relations.py:282 validators.py:137
#: validators.py:300
msgid "This field is required."
msgstr "To pole jest wymagane."

#: fields.py:300
msgid "This field may not be null."
msgstr "Pole nie może mieć wartości null."

#: fields.py:668
msgid "Must be a valid boolean."
msgstr ""

#: fields.py:732
msgid "Not a valid string."
msgstr ""

#: fields.py:733
msgid "This field may not be blank."
msgstr "To pole nie może być puste."

#: fields.py:734 fields.py:1971
#, python-brace-format
msgid "Ensure this field has no more than {max_length} characters."
msgstr "Upewnij się, że to pole ma nie więcej niż {max_length} znaków."

#: fields.py:735
#, python-brace-format
msgid "Ensure this field has at least {min_length} characters."
msgstr "Upewnij się, że pole ma co najmniej {min_length} znaków."

#: fields.py:782
msgid "Enter a valid email address."
msgstr "Podaj poprawny adres e-mail."

#: fields.py:793
msgid "This value does not match the required pattern."
msgstr "Ta wartość nie pasuje do wymaganego wzorca."

#: fields.py:804
msgid ""
"Enter a valid \"slug\" consisting of letters, numbers, underscores or "
"hyphens."
msgstr ""
"Wprowadź poprawną wartość pola typu \"slug\", składającą się ze znaków "
"łacińskich, cyfr, podkreślenia lub myślnika."

#: fields.py:805
msgid ""
"Enter a valid \"slug\" consisting of Unicode letters, numbers, underscores, "
"or hyphens."
msgstr ""

#: fields.py:820
msgid "Enter a valid URL."
msgstr "Wprowadź poprawny adres URL."

#: fields.py:833
msgid "Must be a valid UUID."
msgstr ""

#: fields.py:869
msgid "Enter a valid IPv4 or IPv6 address."
msgstr "Wprowadź poprawny adres IPv4 lub IPv6."

#: fields.py:897
msgid "A valid integer is required."
msgstr "Wymagana poprawna liczba całkowita."

#: fields.py:898 fields.py:936 fields.py:957 fields.py:1001 fields.py:1383
#, python-brace-format
msgid "Ensure this value is less than or equal to {max_value}."
msgstr "Upewnij się, że ta wartość jest mniejsza lub równa {max_value}."

#: fields.py:899 fields.py:937 fields.py:958 fields.py:1002 fields.py:1384
#, python-brace-format
msgid "Ensure this value is greater than or equal to {min_value}."
msgstr "Upewnij się, że ta wartość jest większa lub równa {min_value}."

#: fields.py:900 fields.py:938 fields.py:959 fields.py:1006
msgid "String value too large."
msgstr "Za długi ciąg znaków."

#: fields.py:935
#, fuzzy
#| msgid "A valid integer is required."
msgid "A valid biginteger is required."
msgstr "Wymagana poprawna liczba całkowita."

#: fields.py:956 fields.py:1000
msgid "A valid number is required."
msgstr "Wymagana poprawna liczba."

#: fields.py:960
msgid "Integer value too large to convert to float"
msgstr ""

#: fields.py:1003
#, python-brace-format
msgid "Ensure that there are no more than {max_digits} digits in total."
msgstr "Upewnij się, że liczba ma nie więcej niż {max_digits} cyfr."

#: fields.py:1004
#, python-brace-format
msgid "Ensure that there are no more than {max_decimal_places} decimal places."
msgstr ""
"Upewnij się, że liczba ma nie więcej niż {max_decimal_places} cyfr "
"dziesiętnych."

#: fields.py:1005
#, python-brace-format
msgid ""
"Ensure that there are no more than {max_whole_digits} digits before the "
"decimal point."
msgstr ""
"Upewnij się, że liczba ma nie więcej niż {max_whole_digits} cyfr całkowitych."

#: fields.py:1168
#, python-brace-format
msgid "Datetime has wrong format. Use one of these formats instead: {format}."
msgstr ""
"Wartość daty z czasem ma zły format. Użyj jednego z dostępnych formatów: "
"{format}."

#: fields.py:1169
msgid "Expected a datetime but got a date."
msgstr "Oczekiwano datę z czasem, otrzymano tylko datę."

#: fields.py:1170
#, python-brace-format
msgid "Invalid datetime for the timezone \"{timezone}\"."
msgstr ""

#: fields.py:1171
msgid "Datetime value out of range."
msgstr ""

#: fields.py:1253
#, python-brace-format
msgid "Date has wrong format. Use one of these formats instead: {format}."
msgstr "Data ma zły format. Użyj jednego z tych formatów: {format}."

#: fields.py:1254
msgid "Expected a date but got a datetime."
msgstr "Oczekiwano daty a otrzymano datę z czasem."

#: fields.py:1320
#, python-brace-format
msgid "Time has wrong format. Use one of these formats instead: {format}."
msgstr "Błędny format czasu. Użyj jednego z dostępnych formatów: {format}"

#: fields.py:1382
#, python-brace-format
msgid "Duration has wrong format. Use one of these formats instead: {format}."
msgstr ""
"Czas trwania ma zły format. Użyj w zamian jednego z tych formatów: {format}."

#: fields.py:1385
#, python-brace-format
msgid "The number of days must be between {min_days} and {max_days}."
msgstr ""

#: fields.py:1452 fields.py:1512
#, python-brace-format
msgid "\"{input}\" is not a valid choice."
msgstr "\"{input}\" nie jest poprawnym wyborem."

#: fields.py:1455
#, python-brace-format
msgid "More than {count} items..."
msgstr "Więcej niż {count} elementów..."

#: fields.py:1513 fields.py:1667 relations.py:492 serializers.py:607
#, python-brace-format
msgid "Expected a list of items but got type \"{input_type}\"."
msgstr "Oczekiwano listy elementów, a otrzymano dane typu \"{input_type}\"."

#: fields.py:1514
msgid "This selection may not be empty."
msgstr "Zaznaczenie nie może być puste."

#: fields.py:1558
#, python-brace-format
msgid "\"{input}\" is not a valid path choice."
msgstr "\"{input}\" nie jest poprawną ścieżką."

#: fields.py:1578
msgid "No file was submitted."
msgstr "Nie przesłano pliku."

#: fields.py:1579
msgid "The submitted data was not a file. Check the encoding type on the form."
msgstr "Przesłane dane nie były plikiem. Sprawdź typ kodowania formatki."

#: fields.py:1580
msgid "No filename could be determined."
msgstr "Nie można określić nazwy pliku."

#: fields.py:1581
msgid "The submitted file is empty."
msgstr "Przesłany plik jest pusty."

#: fields.py:1582
#, python-brace-format
msgid ""
"Ensure this filename has at most {max_length} characters (it has {length})."
msgstr ""
"Upewnij się, że nazwa pliku ma długość co najwyżej {max_length} znaków "
"(aktualnie ma {length})."

#: fields.py:1630
msgid ""
"Upload a valid image. The file you uploaded was either not an image or a "
"corrupted image."
msgstr ""
"Prześlij poprawny plik graficzny. Przesłany plik albo nie jest grafiką lub "
"jest uszkodzony."

#: fields.py:1668 relations.py:493 serializers.py:608
msgid "This list may not be empty."
msgstr "Lista nie może być pusta."

#: fields.py:1669 serializers.py:610
#, python-brace-format
msgid "Ensure this field has at least {min_length} elements."
msgstr ""

#: fields.py:1670 serializers.py:609
#, python-brace-format
msgid "Ensure this field has no more than {max_length} elements."
msgstr ""

#: fields.py:1754
#, python-brace-format
