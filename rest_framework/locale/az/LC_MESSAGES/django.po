msgid "Not a valid string."
msgstr ""

#: fields.py:733
msgid "This field may not be blank."
msgstr "Bu sahə boş ola bilməz."

#: fields.py:734 fields.py:1971
#, python-brace-format
msgid "Ensure this field has no more than {max_length} characters."
msgstr "Bu sahənin ən çox {max_length} simvolu olduğuna əmin olun."

#: fields.py:735
#, python-brace-format
msgid "Ensure this field has at least {min_length} characters."
msgstr "Bu sahənin ən az {min_length} simvolu olduğuna əmin olun."

#: fields.py:782
msgid "Enter a valid email address."
msgstr "Keçərli e-poçt ünvanı daxil edin."

#: fields.py:793
msgid "This value does not match the required pattern."
msgstr "Bu dəyər tələb edilən formaya uyğun gəlmir."

#: fields.py:804
msgid ""
"Enter a valid \"slug\" consisting of letters, numbers, underscores or "
"hyphens."
msgstr ""
"Hərf, rəqəm, alt xətt və defislərdən ibarət keçərli \"slug\" daxil edin."

#: fields.py:805
msgid ""
"Enter a valid \"slug\" consisting of Unicode letters, numbers, underscores, "
"or hyphens."
msgstr ""

#: fields.py:820
msgid "Enter a valid URL."
msgstr "Keçərli URL daxil edin."

#: fields.py:833
msgid "Must be a valid UUID."
msgstr ""

#: fields.py:869
msgid "Enter a valid IPv4 or IPv6 address."
msgstr "Keçərli IPv4 və ya IPv6 ünvanı daxil edin."

#: fields.py:897
msgid "A valid integer is required."
msgstr "Keçərli tam ədəd tələb edilir."

#: fields.py:898 fields.py:936 fields.py:957 fields.py:1001 fields.py:1383
#, python-brace-format
msgid "Ensure this value is less than or equal to {max_value}."
msgstr "Bu dəyərin uzunluğunun ən çox {max_value} olduğuna əmin olun."

#: fields.py:899 fields.py:937 fields.py:958 fields.py:1002 fields.py:1384
#, python-brace-format
msgid "Ensure this value is greater than or equal to {min_value}."
msgstr "Bu dəyərin uzunluğunun ən az {min_value} olduğuna əmin olun."

#: fields.py:900 fields.py:938 fields.py:959 fields.py:1006
msgid "String value too large."
msgstr "Yazı dəyəri çox uzundur."

#: fields.py:935
#, fuzzy
#| msgid "A valid integer is required."
msgid "A valid biginteger is required."
msgstr "Keçərli tam ədəd tələb edilir."

#: fields.py:956 fields.py:1000
msgid "A valid number is required."
msgstr "Keçərli rəqəm tələb edilir."

#: fields.py:960
msgid "Integer value too large to convert to float"
msgstr ""

#: fields.py:1003
#, python-brace-format
msgid "Ensure that there are no more than {max_digits} digits in total."
msgstr "Ən çox {max_digits} rəqəm olduğuna əmin olun."

#: fields.py:1004
#, python-brace-format
msgid "Ensure that there are no more than {max_decimal_places} decimal places."
msgstr "Ən çox {max_decimal_places} onluq kəsr hissəsi olduğuna əmin olun."

#: fields.py:1005
#, python-brace-format
msgid ""
"Ensure that there are no more than {max_whole_digits} digits before the "
"decimal point."
msgstr ""
"Onluq kərsdən əvvəl ən çox {max_whole_digits} rəqəm olduğuna əmin olun."

#: fields.py:1168
#, python-brace-format
msgid "Datetime has wrong format. Use one of these formats instead: {format}."
msgstr ""
"Datetime dəyəri səhvdir. Əvəzinə bu formatlardan birini işlədin: {format}."

#: fields.py:1169
msgid "Expected a datetime but got a date."
msgstr "Datetime gözlənirdi amma date gəldi."

#: fields.py:1170
#, python-brace-format
msgid "Invalid datetime for the timezone \"{timezone}\"."
msgstr ""

#: fields.py:1171
msgid "Datetime value out of range."
msgstr ""

#: fields.py:1253
#, python-brace-format
msgid "Date has wrong format. Use one of these formats instead: {format}."
msgstr "Date dəyəri səhvdir. Əvəzinə bu formatlardan birini işlədin: {format}."

#: fields.py:1254
msgid "Expected a date but got a datetime."
msgstr "Date gözlənirdi amma datetime gəldi."

#: fields.py:1320
#, python-brace-format
msgid "Time has wrong format. Use one of these formats instead: {format}."
msgstr ""
"Vaxt formatı səhvdir. Əvəzinə bu formatlardan birini işlədin: {format}."

#: fields.py:1382
#, python-brace-format
msgid "Duration has wrong format. Use one of these formats instead: {format}."
msgstr ""
"Müddət formatı səhvdir. Əvəzinə bu formatlardan birini işlədin: {format}."

#: fields.py:1385
#, python-brace-format
msgid "The number of days must be between {min_days} and {max_days}."
msgstr ""

