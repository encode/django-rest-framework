msgstr "Heç bir fayl göndərilmədi."

#: fields.py:1579
msgid "The submitted data was not a file. Check the encoding type on the form."
msgstr ""
"Göndərilən məlumat fayl deyildi. Anketin şifrələmə (encoding) növünü "
"yoxlayın."

