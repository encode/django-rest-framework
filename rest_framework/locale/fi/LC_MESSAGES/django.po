#: fields.py:299 relations.py:246 relations.py:282 validators.py:137
#: validators.py:300
msgid "This field is required."
msgstr "Tämä kenttä vaaditaan."

#: fields.py:300
msgid "This field may not be null."
msgstr "Tämän kentän arvo ei voi olla \"null\"."

#: fields.py:668
msgid "Must be a valid boolean."
msgstr ""

#: fields.py:732
msgid "Not a valid string."
msgstr ""

#: fields.py:733
msgid "This field may not be blank."
msgstr "Tämä kenttä ei voi olla tyhjä."

#: fields.py:734 fields.py:1971
#, python-brace-format
msgid "Ensure this field has no more than {max_length} characters."
msgstr "Arvo saa olla enintään {max_length} merkkiä pitkä."

#: fields.py:735
#, python-brace-format
msgid "Ensure this field has at least {min_length} characters."
msgstr "Arvo tulee olla vähintään {min_length} merkkiä pitkä."

#: fields.py:782
msgid "Enter a valid email address."
msgstr "Syötä kelvollinen sähköpostiosoite."

#: fields.py:793
msgid "This value does not match the required pattern."
msgstr "Arvo ei täsmää vaadittuun kuvioon."

#: fields.py:804
msgid ""
"Enter a valid \"slug\" consisting of letters, numbers, underscores or "
"hyphens."
msgstr ""
"Tässä voidaan käyttää vain kirjaimia (a-z), numeroita (0-9) sekä ala- ja "
"tavuviivoja (_ -)."

#: fields.py:805
msgid ""
"Enter a valid \"slug\" consisting of Unicode letters, numbers, underscores, "
"or hyphens."
msgstr ""

#: fields.py:820
msgid "Enter a valid URL."
msgstr "Syötä oikea URL-osoite."

#: fields.py:833
msgid "Must be a valid UUID."
msgstr ""

#: fields.py:869
msgid "Enter a valid IPv4 or IPv6 address."
msgstr "Syötä kelvollinen IPv4- tai IPv6-osoite."

#: fields.py:897
msgid "A valid integer is required."
msgstr "Syötä kelvollinen kokonaisluku."

#: fields.py:898 fields.py:936 fields.py:957 fields.py:1001 fields.py:1383
#, python-brace-format
msgid "Ensure this value is less than or equal to {max_value}."
msgstr "Tämän arvon on oltava pienempi tai yhtä suuri kuin {max_value}."

#: fields.py:899 fields.py:937 fields.py:958 fields.py:1002 fields.py:1384
#, python-brace-format
msgid "Ensure this value is greater than or equal to {min_value}."
msgstr "Tämän luvun on oltava suurempi tai yhtä suuri kuin {min_value}."

#: fields.py:900 fields.py:938 fields.py:959 fields.py:1006
msgid "String value too large."
msgstr "Liian suuri merkkijonoarvo."

#: fields.py:935
#, fuzzy
#| msgid "A valid integer is required."
msgid "A valid biginteger is required."
msgstr "Syötä kelvollinen kokonaisluku."

#: fields.py:956 fields.py:1000
msgid "A valid number is required."
msgstr "Kelvollinen luku vaaditaan."

#: fields.py:960
msgid "Integer value too large to convert to float"
msgstr ""

#: fields.py:1003
#, python-brace-format
msgid "Ensure that there are no more than {max_digits} digits in total."
msgstr "Tässä luvussa voi olla yhteensä enintään {max_digits} numeroa."

#: fields.py:1004
#, python-brace-format
msgid "Ensure that there are no more than {max_decimal_places} decimal places."
msgstr "Tässä luvussa voi olla enintään {max_decimal_places} desimaalia."

#: fields.py:1005
#, python-brace-format
msgid ""
"Ensure that there are no more than {max_whole_digits} digits before the "
"decimal point."
msgstr ""
"Tässä luvussa voi olla enintään {max_whole_digits} numeroa ennen "
"desimaalipilkkua."

#: fields.py:1168
#, python-brace-format
msgid "Datetime has wrong format. Use one of these formats instead: {format}."
msgstr ""
"Virheellinen päivämäärän/ajan muotoilu. Käytä jotain näistä muodoista: "
"{format}"

