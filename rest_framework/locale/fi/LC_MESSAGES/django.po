msgid "Expected a datetime but got a date."
msgstr "Odotettiin päivämäärää ja aikaa, saatiin vain päivämäärä."

#: fields.py:1170
#, python-brace-format
msgid "Invalid datetime for the timezone \"{timezone}\"."
msgstr ""

#: fields.py:1171
msgid "Datetime value out of range."
msgstr ""

#: fields.py:1253
#, python-brace-format
msgid "Date has wrong format. Use one of these formats instead: {format}."
msgstr ""
"Virheellinen päivämäärän muotoilu. Käytä jotain näistä muodoista: {format}"

#: fields.py:1254
msgid "Expected a date but got a datetime."
msgstr "Odotettiin päivämäärää, saatiin päivämäärä ja aika."

#: fields.py:1320
#, python-brace-format
msgid "Time has wrong format. Use one of these formats instead: {format}."
msgstr ""
"Virheellinen kellonajan muotoilu. Käytä jotain näistä muodoista: {format}"

#: fields.py:1382
#, python-brace-format
msgid "Duration has wrong format. Use one of these formats instead: {format}."
msgstr "Virheellinen keston muotoilu. Käytä jotain näistä muodoista: {format}"

