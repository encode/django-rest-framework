msgid "navbar"
msgstr "γραμμή πλοήγησης"

#: templates/rest_framework/base.html:75
msgid "content"
msgstr "περιεχόμενο"

#: templates/rest_framework/base.html:78
msgid "request form"
msgstr "φόρμα αιτήματος"

#: templates/rest_framework/base.html:157
