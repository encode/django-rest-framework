#: authentication.py:70
msgid "Invalid basic header. No credentials provided."
msgstr "Λανθασμένη επικεφαλίδα basic. Δεν υπάρχουν διαπιστευτήρια."

#: authentication.py:73
msgid "Invalid basic header. Credentials string should not contain spaces."
msgstr ""
"Λανθασμένη επικεφαλίδα basic. Τα διαπιστευτήρια δεν πρέπει να περιέχουν κενά."

#: authentication.py:84
msgid "Invalid basic header. Credentials not correctly base64 encoded."
msgstr ""
"Λανθασμένη επικεφαλίδα basic. Τα διαπιστευτήρια δεν είναι κωδικοποιημένα "
"κατά base64."

#: authentication.py:101
msgid "Invalid username/password."
msgstr "Λανθασμένο όνομα χρήστη/κωδικός."

#: authentication.py:104 authentication.py:206
msgid "User inactive or deleted."
msgstr "Ο χρήστης είναι ανενεργός ή διεγραμμένος."

#: authentication.py:184
msgid "Invalid token header. No credentials provided."
msgstr "Λανθασμένη επικεφαλίδα token. Δεν υπάρχουν διαπιστευτήρια."

#: authentication.py:187
msgid "Invalid token header. Token string should not contain spaces."
msgstr "Λανθασμένη επικεφαλίδα token. Το token δεν πρέπει να περιέχει κενά."

#: authentication.py:193
msgid ""
"Invalid token header. Token string should not contain invalid characters."
msgstr ""
"Λανθασμένη επικεφαλίδα token. Το token περιέχει μη επιτρεπτούς χαρακτήρες."

#: authentication.py:203
msgid "Invalid token."
msgstr "Λανθασμένο token."

#: authtoken/admin.py:30 authtoken/serializers.py:9
msgid "Username"
msgstr "Όνομα χρήστη"

#: authtoken/apps.py:7
msgid "Auth Token"
msgstr "Token πιστοποίησης"

#: authtoken/models.py:12
msgid "Key"
msgstr "Κλειδί"

#: authtoken/models.py:15
msgid "User"
msgstr "Χρήστης"

#: authtoken/models.py:17
msgid "Created"
msgstr "Δημιουργήθηκε"

#: authtoken/models.py:26 authtoken/models.py:105 authtoken/serializers.py:19
msgid "Token"
msgstr "Token"

#: authtoken/models.py:27 authtoken/models.py:106
msgid "Tokens"
msgstr "Tokens"

#: authtoken/serializers.py:13
msgid "Password"
msgstr "Κωδικός"

#: authtoken/serializers.py:35
msgid "Unable to log in with provided credentials."
msgstr "Δεν είναι δυνατή η σύνδεση με τα διαπιστευτήρια."

#: authtoken/serializers.py:38
msgid "Must include \"username\" and \"password\"."
msgstr "Πρέπει να περιέχει \"όνομα χρήστη\" και \"κωδικό\"."

#: exceptions.py:105
msgid "A server error occurred."
msgstr "Σφάλμα διακομιστή."

#: exceptions.py:145
msgid "Invalid input."
msgstr "Λάθος δεδομένα εισόδου."

#: exceptions.py:166
msgid "Malformed request."
msgstr "Λανθασμένο αίτημα."

#: exceptions.py:172
msgid "Incorrect authentication credentials."
msgstr "Λάθος διαπιστευτήρια."

#: exceptions.py:178
msgid "Authentication credentials were not provided."
msgstr "Δεν δόθηκαν διαπιστευτήρια."

#: exceptions.py:184
msgid "You do not have permission to perform this action."
msgstr "Δεν έχετε δικαίωματα για αυτή την ενέργεια."

#: exceptions.py:190
msgid "Not found."
msgstr "Δε βρέθηκε."

#: exceptions.py:196
#, python-brace-format
msgid "Method \"{method}\" not allowed."
msgstr "Η μέθοδος \"{method}\" δεν επιτρέπεται."

#: exceptions.py:207
msgid "Could not satisfy the request Accept header."
msgstr "Δεν ήταν δυνατή η ικανοποίηση της επικεφαλίδας Accept της αίτησης."

#: exceptions.py:217
#, python-brace-format
msgid "Unsupported media type \"{media_type}\" in request."
msgstr "Δεν υποστηρίζεται το media type \"{media_type}\" της αίτησης."

#: exceptions.py:228
msgid "Request was throttled."
msgstr "Το αίτημα έγινε throttle."

#: exceptions.py:229
#, python-brace-format
msgid "Expected available in {wait} second."
msgstr "Αναμένεται διαθεσιμότητα σε {wait} δευτερόλεπτο."

#: exceptions.py:230
#, python-brace-format
msgid "Expected available in {wait} seconds."
msgstr "Αναμένεται διαθεσιμότητα σε {wait} δευτερόλεπτα."

#: fields.py:299 relations.py:246 relations.py:282 validators.py:137
#: validators.py:300
msgid "This field is required."
msgstr "Το πεδίο είναι απαραίτητο."

#: fields.py:300
msgid "This field may not be null."
msgstr "Το πεδίο δεν μπορεί να είναι null."

#: fields.py:668
msgid "Must be a valid boolean."
msgstr "Πρέπει να είναι έγκυρη τιμή boolean."

#: fields.py:732
msgid "Not a valid string."
msgstr "Μη έγκυρο κείμενο."

#: fields.py:733
msgid "This field may not be blank."
msgstr "Το πεδίο δεν μπορεί να είναι κενό."

#: fields.py:734 fields.py:1971
#, python-brace-format
msgid "Ensure this field has no more than {max_length} characters."
msgstr ""
"Βεβαιωθείτε ότι το πεδίο δεν έχει περισσότερους από {max_length} χαρακτήρες."

#: fields.py:735
#, python-brace-format
msgid "Ensure this field has at least {min_length} characters."
msgstr "Βεβαιωθείτε ότι το πεδίο έχει τουλάχιστον {min_length} χαρακτήρες."

#: fields.py:782
msgid "Enter a valid email address."
msgstr "Εισάγετε μια έγκυρη διεύθυνση ηλ. ταχυδρομείου."

#: fields.py:793
msgid "This value does not match the required pattern."
msgstr "Η τιμή δεν ταιριάζει με το pattern."

#: fields.py:804
msgid ""
"Enter a valid \"slug\" consisting of letters, numbers, underscores or "
"hyphens."
msgstr ""
"Εισάγετε ένα έγκυρο \"slug\" που αποτελείται από γράμματα, αριθμούς, κάτω "
"παύλες ή παύλες."

#: fields.py:805
msgid ""
"Enter a valid \"slug\" consisting of Unicode letters, numbers, underscores, "
"or hyphens."
msgstr ""
"Εισάγετε ένα έγκυρο \"slug\" που αποτελείται από γράμματα Unicode, αριθμούς, "
"κάτω παύλες ή παύλες."

#: fields.py:820
msgid "Enter a valid URL."
msgstr "Εισάγετε ένα έγκυρο URL."

#: fields.py:833
msgid "Must be a valid UUID."
msgstr "Πρέπει να είναι έγκυρο UUID."

#: fields.py:869
msgid "Enter a valid IPv4 or IPv6 address."
msgstr "Εισάγετε μια έγκυρη διεύθυνση IPv4 ή IPv6."

#: fields.py:897
msgid "A valid integer is required."
msgstr "Ένας έγκυρος ακέραιος είναι απαραίτητος."

#: fields.py:898 fields.py:936 fields.py:957 fields.py:1001 fields.py:1383
#, python-brace-format
msgid "Ensure this value is less than or equal to {max_value}."
msgstr "Βεβαιωθείτε ότι η τιμή είναι μικρότερη ή ίση του {max_value}."

#: fields.py:899 fields.py:937 fields.py:958 fields.py:1002 fields.py:1384
#, python-brace-format
msgid "Ensure this value is greater than or equal to {min_value}."
msgstr "Βεβαιωθείτε ότι η τιμή είναι μεγαλύτερη ή ίση του {min_value}."

#: fields.py:900 fields.py:938 fields.py:959 fields.py:1006
msgid "String value too large."
msgstr "Το κείμενο είναι πολύ μεγάλο."

#: fields.py:935
#, fuzzy
#| msgid "A valid integer is required."
msgid "A valid biginteger is required."
msgstr "Ένας έγκυρος ακέραιος είναι απαραίτητος."

#: fields.py:956 fields.py:1000
msgid "A valid number is required."
msgstr "Ένας έγκυρος αριθμός είναι απαραίτητος."

#: fields.py:960
msgid "Integer value too large to convert to float"
msgstr ""

#: fields.py:1003
#, python-brace-format
msgid "Ensure that there are no more than {max_digits} digits in total."
msgstr "Βεβαιωθείτε ότι δεν υπάρχουν παραπάνω από {max_digits} ψηφία."

#: fields.py:1004
#, python-brace-format
msgid "Ensure that there are no more than {max_decimal_places} decimal places."
msgstr ""
"Βεβαιωθείτε ότι δεν υπάρχουν παραπάνω από {max_decimal_places} δεκαδικά "
"ψηφία."

#: fields.py:1005
#, python-brace-format
msgid ""
"Ensure that there are no more than {max_whole_digits} digits before the "
"decimal point."
msgstr ""
"Βεβαιωθείτε ότι δεν υπάρχουν παραπάνω από {max_whole_digits} ακέραια ψηφία."

#: fields.py:1168
#, python-brace-format
msgid "Datetime has wrong format. Use one of these formats instead: {format}."
msgstr ""
"Η ημερομηνία/ώρα έχει λάθος μορφή. Χρησιμοποιήστε μια από τις ακόλουθες "
"μορφές: {format}."

#: fields.py:1169
msgid "Expected a datetime but got a date."
msgstr "Αναμένεται ημερομηνία και ώρα αλλά δόθηκε μόνο ημερομηνία."

#: fields.py:1170
#, python-brace-format
msgid "Invalid datetime for the timezone \"{timezone}\"."
msgstr "Λάθος ημερομηνία/ώρα για τη ζώνη ώρας \"{timezone}\"."

#: fields.py:1171
msgid "Datetime value out of range."
msgstr "Η τιμή ημερομηνίας/ώρας είναι εκτός εύρους."

#: fields.py:1253
#, python-brace-format
msgid "Date has wrong format. Use one of these formats instead: {format}."
msgstr ""
"Η ημερομηνία έχει λάθος μορφή. Χρησιμοποιήστε μια από τις ακόλουθες μορφές: "
"{format}."

#: fields.py:1254
msgid "Expected a date but got a datetime."
msgstr "Αναμένεται ημερομηνία αλλά δόθηκε ημερομηνία και ώρα."

#: fields.py:1320
#, python-brace-format
msgid "Time has wrong format. Use one of these formats instead: {format}."
msgstr ""
"Η ώρα έχει λάθος μορφή. Χρησιμοποιήστε μια από τις ακόλουθες μορφές: "
"{format}."

#: fields.py:1382
#, python-brace-format
msgid "Duration has wrong format. Use one of these formats instead: {format}."
msgstr ""
"Η διάρκεια έχει λάθος μορφή. Χρησιμοποιήστε μια από τις ακόλουθες μορφές: "
"{format}."

#: fields.py:1385
#, python-brace-format
msgid "The number of days must be between {min_days} and {max_days}."
msgstr ""

#: fields.py:1452 fields.py:1512
#, python-brace-format
msgid "\"{input}\" is not a valid choice."
msgstr "Το \"{input}\" δεν είναι έγκυρη επιλογή."

#: fields.py:1455
#, python-brace-format
msgid "More than {count} items..."
msgstr "Περισσότερα από {count} αντικείμενα..."

#: fields.py:1513 fields.py:1667 relations.py:492 serializers.py:607
#, python-brace-format
msgid "Expected a list of items but got type \"{input_type}\"."
msgstr ""
"Αναμένεται μια λίστα αντικειμένων αλλά δόθηκε ο τύπος \"{input_type}\"."

#: fields.py:1514
msgid "This selection may not be empty."
msgstr "Η επιλογή δεν μπορεί να είναι κενή."

#: fields.py:1558
#, python-brace-format
msgid "\"{input}\" is not a valid path choice."
msgstr "Το \"{input}\" δεν είναι έγκυρη επιλογή διαδρομής."

#: fields.py:1578
msgid "No file was submitted."
msgstr "Δεν υποβλήθηκε αρχείο."

#: fields.py:1579
msgid "The submitted data was not a file. Check the encoding type on the form."
msgstr ""
"Τα δεδομένα που υποβλήθηκαν δεν ήταν αρχείο. Ελέγξτε την κωδικοποίηση της "
"φόρμας."

#: fields.py:1580
msgid "No filename could be determined."
msgstr "Δε βρέθηκε όνομα αρχείου."

#: fields.py:1581
msgid "The submitted file is empty."
msgstr "Το αρχείο που υποβλήθηκε είναι κενό."

#: fields.py:1582
#, python-brace-format
msgid ""
"Ensure this filename has at most {max_length} characters (it has {length})."
msgstr ""
"Βεβαιωθείτε ότι το όνομα αρχείου έχει το πολύ {max_length} χαρακτήρες (έχει "
"{length})."

#: fields.py:1630
msgid ""
"Upload a valid image. The file you uploaded was either not an image or a "
"corrupted image."
msgstr ""
"Ανεβάστε μια έγκυρη εικόνα. Το αρχείο που ανεβάσατε είτε δεν είναι εικόνα "
"είτε έχει καταστραφεί."

#: fields.py:1668 relations.py:493 serializers.py:608
msgid "This list may not be empty."
msgstr "Η λίστα δεν μπορεί να είναι κενή."

#: fields.py:1669 serializers.py:610
#, python-brace-format
msgid "Ensure this field has at least {min_length} elements."
msgstr "Βεβαιωθείτε ότι το πεδίο έχει τουλάχιστον {min_length} στοιχεία."

#: fields.py:1670 serializers.py:609
#, python-brace-format
msgid "Ensure this field has no more than {max_length} elements."
msgstr ""
"Βεβαιωθείτε ότι το πεδίο δεν έχει περισσότερα από {max_length} στοιχεία."

#: fields.py:1754
#, python-brace-format
msgid "Expected a dictionary of items but got type \"{input_type}\"."
msgstr ""
"Αναμένεται ένα λεξικό αντικειμένων αλλά δόθηκε ο τύπος \"{input_type}\"."

#: fields.py:1755
msgid "This dictionary may not be empty."
msgstr "Το λεξικό δεν μπορεί να είναι κενό."

#: fields.py:1840
msgid "Value must be valid JSON."
msgstr "Η τιμή πρέπει να είναι μορφής JSON."

#: filters.py:63 templates/rest_framework/filters/search.html:2
#: templates/rest_framework/filters/search.html:8
msgid "Search"
msgstr "Αναζήτηση"

#: filters.py:64
msgid "A search term."
msgstr "Ένας όρος αναζήτησης."

#: filters.py:219 templates/rest_framework/filters/ordering.html:3
msgid "Ordering"
msgstr "Ταξινόμηση"

#: filters.py:220
msgid "Which field to use when ordering the results."
msgstr "Ποιο πεδίο θα χρησιμοποιηθεί για την ταξινόμηση των αποτελεσμάτων."

#: filters.py:340
msgid "ascending"
msgstr "αύξουσα"

#: filters.py:341
msgid "descending"
msgstr "φθίνουσα"

#: pagination.py:171
msgid "A page number within the paginated result set."
msgstr "Ένας αριθμός σελίδας μέσα στο σύνολο αποτελεσμάτων με σελιδοποίηση."

#: pagination.py:176 pagination.py:343 pagination.py:534
msgid "Number of results to return per page."
msgstr "Πλήθος αποτελεσμάτων που θα επιστρέφονται ανά σελίδα."

#: pagination.py:186
msgid "Invalid page."
msgstr "Λάθος σελίδα."

#: pagination.py:345
msgid "The initial index from which to return the results."
msgstr "Ο αρχικός δείκτης από τον οποίο θα επιστραφούν τα αποτελέσματα."

#: pagination.py:525
msgid "The pagination cursor value."
msgstr "Η τιμή του cursor σελιδοποίησης."

#: pagination.py:527
msgid "Invalid cursor"
msgstr "Λάθος cursor"

#: relations.py:247
#, python-brace-format
msgid "Invalid pk \"{pk_value}\" - object does not exist."
msgstr "Λάθος κλειδί \"{pk_value}\" - το αντικείμενο δεν υπάρχει."

#: relations.py:248
#, python-brace-format
msgid "Incorrect type. Expected pk value, received {data_type}."
msgstr "Λάθος τύπος. Αναμένεται τιμή κλειδιού, δόθηκε {data_type}."

#: relations.py:283
msgid "Invalid hyperlink - No URL match."
msgstr "Λάθος σύνδεση - δεν ταιριάζει κάποιο URL."

#: relations.py:284
msgid "Invalid hyperlink - Incorrect URL match."
msgstr "Λάθος σύνδεση - λανθασμένη αντιστοίχιση URL."

#: relations.py:285
msgid "Invalid hyperlink - Object does not exist."
msgstr "Λάθος σύνδεση - το αντικείμενο δεν υπάρχει."

#: relations.py:286
#, python-brace-format
msgid "Incorrect type. Expected URL string, received {data_type}."
msgstr "Λάθος τύπος. Αναμένεται URL, δόθηκε {data_type}."

#: relations.py:451
#, python-brace-format
msgid "Object with {slug_name}={value} does not exist."
msgstr "Το αντικείμενο {slug_name}={value} δεν υπάρχει."

#: relations.py:452
msgid "Invalid value."
msgstr "Λάθος τιμή."

#: schemas/utils.py:32
msgid "unique integer value"
msgstr "μοναδική ακέραια τιμή"

#: schemas/utils.py:34
msgid "UUID string"
msgstr "κείμενο UUID"

#: schemas/utils.py:36
msgid "unique value"
msgstr "μοναδική τιμή"

#: schemas/utils.py:38
#, python-brace-format
msgid "A {value_type} identifying this {name}."
msgstr "Αναγνωριστικό για το αντικείμενο {name} ({value_type})."

#: serializers.py:354
#, python-brace-format
msgid "Invalid data. Expected a dictionary, but got {datatype}."
msgstr "Λάθος δεδομένα. Αναμένεται λεξικό αλλά δόθηκε {datatype}."

