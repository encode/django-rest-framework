#: authentication.py:70
msgid "Invalid basic header. No credentials provided."
msgstr "Formato do cabeçalho Basic inválido. Credenciais não fornecidas."

#: authentication.py:73
msgid "Invalid basic header. Credentials string should not contain spaces."
msgstr ""
"Formato do cabeçalho Basic inválido. As credenciais não devem conter espaços."

#: authentication.py:84
msgid "Invalid basic header. Credentials not correctly base64 encoded."
msgstr ""
"Formato do cabeçalho Basic inválido. As credenciais não foram codificadas "
"corretamente em base64."

#: authentication.py:101
msgid "Invalid username/password."
msgstr "Usuário ou senha inválidos."

#: authentication.py:104 authentication.py:206
msgid "User inactive or deleted."
msgstr "Usuário inativo ou removido."

#: authentication.py:184
msgid "Invalid token header. No credentials provided."
msgstr "Formato do cabeçalho de token inválido. Credenciais não fornecidas."

#: authentication.py:187
msgid "Invalid token header. Token string should not contain spaces."
msgstr ""
"Formato do cabeçalho de token inválido. O token não deve conter espaços."

#: authentication.py:193
msgid ""
"Invalid token header. Token string should not contain invalid characters."
msgstr ""
"Formato do cabeçalho de token inválido. O token não deve conter caracteres "
"inválidos."

#: authentication.py:203
msgid "Invalid token."
msgstr "Token inválido."

#: authtoken/admin.py:30 authtoken/serializers.py:9
msgid "Username"
msgstr "Nome de usuário"

#: authtoken/apps.py:7
msgid "Auth Token"
msgstr "Token de autenticação"

#: authtoken/models.py:12
msgid "Key"
msgstr "Chave"

#: authtoken/models.py:15
msgid "User"
msgstr "Usuário"

#: authtoken/models.py:17
msgid "Created"
msgstr "Criado"

#: authtoken/models.py:26 authtoken/models.py:105 authtoken/serializers.py:19
msgid "Token"
msgstr "Token"

#: authtoken/models.py:27 authtoken/models.py:106
msgid "Tokens"
msgstr "Tokens"

#: authtoken/serializers.py:13
msgid "Password"
msgstr "Senha"

#: authtoken/serializers.py:35
msgid "Unable to log in with provided credentials."
msgstr "Não foi possível autenticar com as credenciais fornecidas."

#: authtoken/serializers.py:38
msgid "Must include \"username\" and \"password\"."
msgstr "Deve incluir \"username\" e \"password\"."

#: exceptions.py:105
msgid "A server error occurred."
msgstr "Ocorreu um erro no servidor."

#: exceptions.py:145
msgid "Invalid input."
msgstr "Entrada inválida."

#: exceptions.py:166
msgid "Malformed request."
msgstr "Requisição malformada."

#: exceptions.py:172
msgid "Incorrect authentication credentials."
msgstr "Credenciais de autenticação incorretas."

#: exceptions.py:178
msgid "Authentication credentials were not provided."
msgstr "As credenciais de autenticação não foram fornecidas."

#: exceptions.py:184
msgid "You do not have permission to perform this action."
msgstr "Você não tem permissão para executar essa ação."

#: exceptions.py:190
msgid "Not found."
msgstr "Não encontrado."

#: exceptions.py:196
#, python-brace-format
msgid "Method \"{method}\" not allowed."
msgstr "Método \"{method}\" não é permitido."

#: exceptions.py:207
msgid "Could not satisfy the request Accept header."
msgstr "Não foi possível atender ao cabeçalho Accept da requisição."

#: exceptions.py:217
#, python-brace-format
msgid "Unsupported media type \"{media_type}\" in request."
msgstr "Tipo de mídia \"{media_type}\" não suportado."

#: exceptions.py:228
msgid "Request was throttled."
msgstr "O limite de requisições foi excedido."

#: exceptions.py:229
#, python-brace-format
msgid "Expected available in {wait} second."
msgstr "Espera-se que esteja disponível em {wait} segundo."

#: exceptions.py:230
#, python-brace-format
msgid "Expected available in {wait} seconds."
msgstr "Espera-se que esteja disponível em {wait} segundos."

#: fields.py:299 relations.py:246 relations.py:282 validators.py:137
#: validators.py:300
msgid "This field is required."
msgstr "Este campo é obrigatório."

#: fields.py:300
msgid "This field may not be null."
msgstr "Este campo não pode ser nulo."

#: fields.py:668
msgid "Must be a valid boolean."
msgstr "Deve ser um valor booleano válido."

#: fields.py:732
msgid "Not a valid string."
msgstr "Não é uma string válida."

#: fields.py:733
msgid "This field may not be blank."
msgstr "Este campo não pode estar em branco."

#: fields.py:734 fields.py:1971
#, python-brace-format
msgid "Ensure this field has no more than {max_length} characters."
msgstr ""
"Certifique-se de que este campo não tenha mais de {max_length} caracteres."

#: fields.py:735
#, python-brace-format
msgid "Ensure this field has at least {min_length} characters."
msgstr ""
"Certifique-se de que este campo tenha pelo menos {min_length} caracteres."

#: fields.py:782
msgid "Enter a valid email address."
msgstr "Insira um endereço de email válido."

#: fields.py:793
msgid "This value does not match the required pattern."
msgstr "Este valor não corresponde ao padrão exigido."

#: fields.py:804
msgid ""
"Enter a valid \"slug\" consisting of letters, numbers, underscores or "
"hyphens."
msgstr ""
"Insira um \"slug\" válido que consista em letras, números, sublinhados ou "
"hífens."

#: fields.py:805
msgid ""
"Enter a valid \"slug\" consisting of Unicode letters, numbers, underscores, "
"or hyphens."
msgstr ""
"Insira um \"slug\" válido que consista em letras Unicode, números, "
"sublinhados ou hífens."

#: fields.py:820
msgid "Enter a valid URL."
msgstr "Insira uma URL válida."

#: fields.py:833
msgid "Must be a valid UUID."
msgstr "Deve ser um UUID válido."

#: fields.py:869
msgid "Enter a valid IPv4 or IPv6 address."
msgstr "Informe um endereço IPv4 ou IPv6 válido."

#: fields.py:897
msgid "A valid integer is required."
msgstr "Um número inteiro válido é exigido."

#: fields.py:898 fields.py:936 fields.py:957 fields.py:1001 fields.py:1383
#, python-brace-format
msgid "Ensure this value is less than or equal to {max_value}."
msgstr "Certifique-se de que este valor seja menor ou igual a {max_value}."

#: fields.py:899 fields.py:937 fields.py:958 fields.py:1002 fields.py:1384
#, python-brace-format
msgid "Ensure this value is greater than or equal to {min_value}."
msgstr "Certifique-se de que este valor seja maior ou igual a {min_value}."

#: fields.py:900 fields.py:938 fields.py:959 fields.py:1006
msgid "String value too large."
msgstr "Valor da string é muito grande."

#: fields.py:935
#, fuzzy
#| msgid "A valid integer is required."
msgid "A valid biginteger is required."
msgstr "Um número inteiro válido é exigido."

#: fields.py:956 fields.py:1000
msgid "A valid number is required."
msgstr "Um número válido é necessário."

#: fields.py:960
msgid "Integer value too large to convert to float"
msgstr ""

#: fields.py:1003
#, python-brace-format
msgid "Ensure that there are no more than {max_digits} digits in total."
msgstr "Certifique-se de que não haja mais de {max_digits} dígitos no total."

#: fields.py:1004
#, python-brace-format
msgid "Ensure that there are no more than {max_decimal_places} decimal places."
msgstr ""
"Certifique-se de que não haja mais de {max_decimal_places} casas decimais."

#: fields.py:1005
#, python-brace-format
msgid ""
"Ensure that there are no more than {max_whole_digits} digits before the "
"decimal point."
msgstr ""
"Certifique-se de que não haja mais de {max_whole_digits} dígitos antes do "
"ponto decimal."

#: fields.py:1168
#, python-brace-format
msgid "Datetime has wrong format. Use one of these formats instead: {format}."
msgstr ""
"Formato inválido para data e hora. Use um dos formatos a seguir: {format}."

#: fields.py:1169
msgid "Expected a datetime but got a date."
msgstr "Esperava-se uma data e hora, mas foi recebida uma data."

#: fields.py:1170
#, python-brace-format
msgid "Invalid datetime for the timezone \"{timezone}\"."
msgstr "Data e hora inválidas para o fuso horário \"{timezone}\"."

#: fields.py:1171
msgid "Datetime value out of range."
msgstr "Valor de data e hora fora do intervalo."

#: fields.py:1253
#, python-brace-format
msgid "Date has wrong format. Use one of these formats instead: {format}."
msgstr "Formato de data inválido. Use um dos formatos a seguir: {format}."

#: fields.py:1254
msgid "Expected a date but got a datetime."
msgstr "Esperava-se uma data, mas foi recebida uma data e hora."

#: fields.py:1320
#, python-brace-format
msgid "Time has wrong format. Use one of these formats instead: {format}."
msgstr "Formato de hora inválido. Use um dos formatos a seguir: {format}."

#: fields.py:1382
#, python-brace-format
msgid "Duration has wrong format. Use one of these formats instead: {format}."
msgstr "Formato inválido para duração. Use um dos formatos a seguir: {format}."

#: fields.py:1385
#, python-brace-format
msgid "The number of days must be between {min_days} and {max_days}."
msgstr ""

#: fields.py:1452 fields.py:1512
#, python-brace-format
msgid "\"{input}\" is not a valid choice."
msgstr "\"{input}\" não é uma escolha válida."

#: fields.py:1455
#, python-brace-format
msgid "More than {count} items..."
msgstr "Mais de {count} itens..."

#: fields.py:1513 fields.py:1667 relations.py:492 serializers.py:607
#, python-brace-format
msgid "Expected a list of items but got type \"{input_type}\"."
msgstr ""
"Esperava-se uma lista de itens, mas foi recebido o tipo \"{input_type}\"."

#: fields.py:1514
msgid "This selection may not be empty."
msgstr "Esta seleção não pode estar vazia."

#: fields.py:1558
#, python-brace-format
msgid "\"{input}\" is not a valid path choice."
msgstr "\"{input}\" não é uma escolha válida de caminho."

#: fields.py:1578
msgid "No file was submitted."
msgstr "Nenhum arquivo foi enviado."

#: fields.py:1579
msgid "The submitted data was not a file. Check the encoding type on the form."
msgstr ""
"O dado enviado não era um arquivo. Verifique o tipo de codificação no "
"formulário."

#: fields.py:1580
msgid "No filename could be determined."
msgstr "Não foi possível determinar o nome do arquivo."

#: fields.py:1581
msgid "The submitted file is empty."
msgstr "O arquivo submetido está vazio."

#: fields.py:1582
#, python-brace-format
msgid ""
"Ensure this filename has at most {max_length} characters (it has {length})."
msgstr ""
"Certifique-se de que o nome do arquivo tenha no máximo {max_length} "
"caracteres (tem {length})."

#: fields.py:1630
msgid ""
"Upload a valid image. The file you uploaded was either not an image or a "
"corrupted image."
msgstr ""
"Faça upload de uma imagem válida. O arquivo enviado não é um arquivo de "
"imagem ou está corrompido."

#: fields.py:1668 relations.py:493 serializers.py:608
msgid "This list may not be empty."
msgstr "Esta lista não pode estar vazia."

#: fields.py:1669 serializers.py:610
#, python-brace-format
msgid "Ensure this field has at least {min_length} elements."
msgstr ""
"Certifique-se de que este campo tenha pelo menos {min_length} elementos."

#: fields.py:1670 serializers.py:609
#, python-brace-format
msgid "Ensure this field has no more than {max_length} elements."
msgstr ""
"Certifique-se de que este campo não tenha mais de {max_length} elementos."

#: fields.py:1754
#, python-brace-format
msgid "Expected a dictionary of items but got type \"{input_type}\"."
msgstr ""
"Esperava-se um dicionário de itens, mas foi recebido o tipo \"{input_type}\"."

#: fields.py:1755
msgid "This dictionary may not be empty."
msgstr "Este dicionário não pode estar vazio."

#: fields.py:1840
msgid "Value must be valid JSON."
msgstr "Valor deve ser JSON válido."

