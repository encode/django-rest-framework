msgstr "Neplatný formát požadavku."

#: exceptions.py:172
msgid "Incorrect authentication credentials."
msgstr "Chybné přihlašovací údaje."

#: exceptions.py:178
msgid "Authentication credentials were not provided."
msgstr "Nebyly zadány přihlašovací údaje."

#: exceptions.py:184
msgid "You do not have permission to perform this action."
msgstr "K této akci nemáte oprávnění."

#: exceptions.py:190
msgid "Not found."
msgstr "Nenalezeno."

#: exceptions.py:196
#, python-brace-format
msgid "Method \"{method}\" not allowed."
msgstr "Metoda \"{method}\" není povolena."

#: exceptions.py:207
msgid "Could not satisfy the request Accept header."
msgstr "Nelze vyhovět požadavku v hlavičce Accept."

#: exceptions.py:217
#, python-brace-format
msgid "Unsupported media type \"{media_type}\" in request."
msgstr "Nepodporovaný media type \"{media_type}\" v požadavku."

#: exceptions.py:228
msgid "Request was throttled."
msgstr ""
"Požadavek byl limitován kvůli omezení počtu požadavků za časovou periodu."

#: exceptions.py:229
#, python-brace-format
