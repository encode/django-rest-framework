#: fields.py:299 relations.py:246 relations.py:282 validators.py:137
#: validators.py:300
msgid "This field is required."
msgstr "Toto pole je vyžadováno."

#: fields.py:300
msgid "This field may not be null."
msgstr "Toto pole nesmí být prázdné (null)."

#: fields.py:668
msgid "Must be a valid boolean."
msgstr ""

#: fields.py:732
msgid "Not a valid string."
msgstr ""

#: fields.py:733
msgid "This field may not be blank."
msgstr "Toto pole nesmí být prázdné."

#: fields.py:734 fields.py:1971
#, python-brace-format
msgid "Ensure this field has no more than {max_length} characters."
msgstr "Zkontrolujte, že toto pole není delší než {max_length} znaků."

#: fields.py:735
#, python-brace-format
msgid "Ensure this field has at least {min_length} characters."
msgstr "Zkontrolujte, že toto pole obsahuje alespoň {min_length} znaků."

#: fields.py:782
msgid "Enter a valid email address."
msgstr "Vložte platnou e-mailovou adresu."

#: fields.py:793
msgid "This value does not match the required pattern."
msgstr "Hodnota v tomto poli neodpovídá požadovanému formátu."

#: fields.py:804
msgid ""
"Enter a valid \"slug\" consisting of letters, numbers, underscores or "
"hyphens."
msgstr ""
"Vložte platnou \"zkrácenou formu\" obsahující pouze malá písmena, čísla, "
"spojovník nebo podtržítko."

#: fields.py:805
msgid ""
"Enter a valid \"slug\" consisting of Unicode letters, numbers, underscores, "
"or hyphens."
msgstr ""

#: fields.py:820
msgid "Enter a valid URL."
msgstr "Vložte platný odkaz."

#: fields.py:833
msgid "Must be a valid UUID."
msgstr ""

#: fields.py:869
msgid "Enter a valid IPv4 or IPv6 address."
msgstr "Vložte platnou IPv4 nebo IPv6 adresu."

#: fields.py:897
msgid "A valid integer is required."
msgstr "Je vyžadováno celé číslo."

#: fields.py:898 fields.py:936 fields.py:957 fields.py:1001 fields.py:1383
#, python-brace-format
msgid "Ensure this value is less than or equal to {max_value}."
msgstr "Zkontrolujte, že hodnota je menší nebo rovna {max_value}."

#: fields.py:899 fields.py:937 fields.py:958 fields.py:1002 fields.py:1384
#, python-brace-format
msgid "Ensure this value is greater than or equal to {min_value}."
msgstr "Zkontrolujte, že hodnota je větší nebo rovna {min_value}."

#: fields.py:900 fields.py:938 fields.py:959 fields.py:1006
msgid "String value too large."
msgstr "Řetězec je příliš dlouhý."

#: fields.py:935
#, fuzzy
#| msgid "A valid integer is required."
msgid "A valid biginteger is required."
msgstr "Je vyžadováno celé číslo."

#: fields.py:956 fields.py:1000
msgid "A valid number is required."
msgstr "Je vyžadováno číslo."

#: fields.py:960
msgid "Integer value too large to convert to float"
msgstr ""

#: fields.py:1003
#, python-brace-format
msgid "Ensure that there are no more than {max_digits} digits in total."
msgstr "Zkontrolujte, že číslo neobsahuje více než {max_digits} čislic."

#: fields.py:1004
#, python-brace-format
msgid "Ensure that there are no more than {max_decimal_places} decimal places."
msgstr ""
"Zkontrolujte, že číslo nemá více než {max_decimal_places} desetinných míst."

#: fields.py:1005
#, python-brace-format
msgid ""
"Ensure that there are no more than {max_whole_digits} digits before the "
"decimal point."
msgstr ""
"Zkontrolujte, že číslo neobsahuje více než {max_whole_digits} čislic před "
"desetinnou čárkou."

#: fields.py:1168
#, python-brace-format
msgid "Datetime has wrong format. Use one of these formats instead: {format}."
msgstr "Chybný formát data a času. Použijte jeden z těchto formátů: {format}."

#: fields.py:1169
msgid "Expected a datetime but got a date."
msgstr "Bylo zadáno pouze datum bez času."

#: fields.py:1170
#, python-brace-format
msgid "Invalid datetime for the timezone \"{timezone}\"."
msgstr ""

#: fields.py:1171
msgid "Datetime value out of range."
msgstr ""

#: fields.py:1253
#, python-brace-format
msgid "Date has wrong format. Use one of these formats instead: {format}."
msgstr "Chybný formát data. Použijte jeden z těchto formátů: {format}."

#: fields.py:1254
msgid "Expected a date but got a datetime."
msgstr "Bylo zadáno datum a čas, místo samotného data."

#: fields.py:1320
#, python-brace-format
msgid "Time has wrong format. Use one of these formats instead: {format}."
msgstr "Chybný formát času. Použijte jeden z těchto formátů: {format}."

#: fields.py:1382
#, python-brace-format
msgid "Duration has wrong format. Use one of these formats instead: {format}."
msgstr "Trvání má nesprávný formát. Použijte jeden z následujících: {format}."

#: fields.py:1385
#, python-brace-format
msgid "The number of days must be between {min_days} and {max_days}."
msgstr ""

#: fields.py:1452 fields.py:1512
#, python-brace-format
msgid "\"{input}\" is not a valid choice."
msgstr "\"{input}\" není platnou možností."

#: fields.py:1455
#, python-brace-format
msgid "More than {count} items..."
msgstr "Více než {count} položek..."

#: fields.py:1513 fields.py:1667 relations.py:492 serializers.py:607
#, python-brace-format
msgid "Expected a list of items but got type \"{input_type}\"."
msgstr "Byl očekáván seznam položek ale nalezen \"{input_type}\"."

#: fields.py:1514
msgid "This selection may not be empty."
msgstr "Tento výběr by neměl být prázdný."

#: fields.py:1558
#, python-brace-format
msgid "\"{input}\" is not a valid path choice."
msgstr "\"{input}\" není validní cesta k souboru."

#: fields.py:1578
msgid "No file was submitted."
msgstr "Nebyl zaslán žádný soubor."

#: fields.py:1579
msgid "The submitted data was not a file. Check the encoding type on the form."
msgstr ""
"Zaslaná data neobsahují soubor. Zkontrolujte typ kódování ve formuláři."

#: fields.py:1580
msgid "No filename could be determined."
msgstr "Nebylo možné zjistit jméno souboru."

#: fields.py:1581
msgid "The submitted file is empty."
msgstr "Zaslaný soubor je prázdný."

#: fields.py:1582
#, python-brace-format
msgid ""
"Ensure this filename has at most {max_length} characters (it has {length})."
msgstr ""
"Zajistěte, aby jméno souboru obsahovalo maximálně {max_length} znaků (teď má "
"{length} znaků)."

#: fields.py:1630
msgid ""
"Upload a valid image. The file you uploaded was either not an image or a "
"corrupted image."
msgstr ""
"Nahrajte platný obrázek. Nahraný soubor buď není obrázkem nebo je poškozen."

#: fields.py:1668 relations.py:493 serializers.py:608
msgid "This list may not be empty."
msgstr "Tento list by neměl být prázdný."

#: fields.py:1669 serializers.py:610
#, python-brace-format
msgid "Ensure this field has at least {min_length} elements."
msgstr ""

#: fields.py:1670 serializers.py:609
#, python-brace-format
msgid "Ensure this field has no more than {max_length} elements."
